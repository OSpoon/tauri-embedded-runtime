{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-embedded-runtime",
  "version": "0.0.0",
  "identifier": "com.osp.tauri-embedded-runtime",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri Embedded Runtime",
        "width": 840,
        "height": 560,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFMUYxOEE0NUE5QzE5NjMKUldSakdaeGFwQmdmZnNWNXdpUVJXdkNXU1g0dDUybXgxa3BGRGJBM1ZhUXBRR05oUGZWOURUM0EK",
      "endpoints": [
        "https://github.com/OSpoon/tauri-embedded-runtime/releases/latest/download/latest.json"
      ]
    }
  }
}
