{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-runtime-app",
  "version": "0.1.2-beta.2",
  "identifier": "com.osp.tauri-runtime-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "runtime · local workspace",
        "width": 960,
        "height": 640,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
